# ── Auth — NEVER commit session data ──────────────────────────────────────
# Covers session/, session.bak-*/, session.dead-*/ and any future variant.
session*/

# ── Runtime state — queue database and file spool ─────────────────────────
data/
spool/

# ── Dependencies ──────────────────────────────────────────────────────────
node_modules/

# ── Environment ───────────────────────────────────────────────────────────
.env

# ── OS ────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Agent tooling — local config, not part of the service ─────────────────
