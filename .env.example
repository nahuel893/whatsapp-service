# WhatsApp Service — Configuration
#
# Copy this file to .env and adjust values for your environment.

# Port for the HTTP API (default: 3001)
PORT=3001

# Directory for Baileys session persistence (default: ./session)
# SESSION_DIR=./session

# Runtime environment (development | production)
# NODE_ENV=production

# Print QR to terminal on first auth (default: false in production)
# PRINT_QR=true
